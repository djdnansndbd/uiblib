-- Config System
-- ==========================================

local function jsonSerialize(t)
    local result = "{"
    local first = true
    for k, v in pairs(t) do
        if not first then result = result .. "," end
        first = false
        local key = '"' .. tostring(k) .. '"'
        local val
        if type(v) == "boolean" then
            val = tostring(v)
        elseif type(v) == "number" then
            val = tostring(v)
        else
            val = '"' .. tostring(v):gsub('"', '\\"') .. '"'
        end
        result = result .. key .. ":" .. val
    end
    return result .. "}"
end

local function jsonParse(s)
    local out = {}
    for k, v in s:gmatch('"([^"]+)":([^,}]+)') do
        v = v:gsub('^%s*', ''):gsub('%s*$', '')
        if v == "true" then
            out[k] = true
        elseif v == "false" then
            out[k] = false
        elseif v:sub(1,1) == '"' then
            out[k] = v:sub(2, -2)
        else
            out[k] = tonumber(v) or v
        end
    end
    return out
end

local function getConfigPath(name)
    return Library.ConfigFolder .. "/" .. (name or "default") .. ".json"
end

function Library:SaveConfig(name)
    local data = {}
    for flag, entry in pairs(self.Flags) do
        local ok, val = pcall(entry.Get)
        if ok then data[flag] = val end
    end
    local path = getConfigPath(name)
    local ok, err = pcall(function()
        if not isfolder(Library.ConfigFolder) then
            makefolder(Library.ConfigFolder)
        end
        writefile(path, jsonSerialize(data))
    end)
end

function Library:LoadConfig(name)
    local path = getConfigPath(name)
    local ok, content = pcall(readfile, path)
    if not ok or not content or content == "" then return end
    local data = jsonParse(content)
    for flag, val in pairs(data) do
        if self.Flags[flag] then
            pcall(self.Flags[flag].Set, val)
        end
    end
end

function Library:ResetConfig(name)
    local path = getConfigPath(name)
    pcall(delfile, path)
end

return Library
