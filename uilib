        function TabObj:AddDropdown(arg1, arg2)
            local config = type(arg1) == "table" and arg1 or (arg2 or {})
            if type(arg1) == "string" then config.Title = config.Title or arg1 end

            local title = config.Title or "Dropdown"
            local options = config.Options or config.Values or {}
            local default = config.Default or (config.Multi and {} or (options[1] or ""))
            local callback = config.Callback or function() end
            local onChangedCallback = nil
            local isOpen = false
            local multi = config.Multi or false

            local selected = {}
            if multi then
                if typeof(default) == "table" then
                    for _, v in ipairs(default) do selected[v] = true end
                elseif default then
                    selected[default] = true
                end
            else
