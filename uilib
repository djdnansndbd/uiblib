            Tween(NotificationFrame, {BackgroundTransparency = 1}, 0.15)
            Tween(SliderBackground, {BackgroundTransparency = 1}, 0.15)
            task.delay(0.15, function()
                if NotificationFrame then
                    NotificationFrame:Destroy()
                end
            end)
        end

        CloseButton.MouseButton1Click:Connect(closeNotification)

        task.spawn(function()
            while not closed do
                local now = tick()
                local timeLeft = math.max(0, activeNotification.EndTime - now)
                local durationValue = activeNotification.Duration
                local percent = durationValue > 0 and (timeLeft / durationValue) or 0
                SliderFill.Size = UDim2.new(percent, 0, 1, 0)
                if timeLeft <= 0 then
                    closeNotification()
                    break
                end
                RunService.Heartbeat:Wait()
            end
        end)
    end

    task.defer(function()
        Library:LoadConfig("default")
    end)

    return WindowObj
end

