            })
            Create("UICorner", { Parent = Thumb, CornerRadius = UDim.new(1, 0) })
            Create("UIStroke", { Parent = Thumb, Color = Color3.fromRGB(255,255,255), Thickness = 2, Transparency = 0.7 })

            local HitBox = Create("TextButton", {
                Parent = TrackBg,
                Size = UDim2.new(1, 1, 1, 0),
                BackgroundTransparency = 1,
                Text = "",
                AutoButtonColor = false
            })

            local flagName = sanitizeFlagName(config.Flag or title)
            if flagName and Library.Options then
                Library.Options[flagName] = Library.Options[flagName] or { Value = default }
            end

            local function setPercent(p)
                currentPercent = math.clamp(p, 0, 1)
                TrackFill.Size = UDim2.new(currentPercent, 0, 1, 0)
                Thumb.Position = UDim2.new(currentPercent, -7, 0.5, -7)
                local displayVal = math.floor(min + (max - min) * currentPercent + 0.5)
                ValueBox.Text = tostring(displayVal)
                if flagName and Library.Options then
                    Library.Options[flagName] = Library.Options[flagName] or {}
                    Library.Options[flagName].Value = displayVal
                end
                pcall(callback, displayVal)
                if onChangedCallback then
                    pcall(onChangedCallback, displayVal)
                end
                saveDefaultConfig()
            end

            local function getPercent(inputX)
                local trackLeft = TrackBg.AbsolutePosition.X
                local trackWidth = TrackBg.AbsoluteSize.X
                return math.clamp((inputX - trackLeft) / trackWidth, 0, 1)
            end

            HitBox.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    Thumb.Size = UDim2.new(0, 18, 0, 18)
                    Thumb.Position = UDim2.new(currentPercent, -9, 0.5, -9)
                    setPercent(getPercent(input.Position.X))
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local p = getPercent(input.Position.X)
                    currentPercent = math.clamp(p, 0, 1)
                    TrackFill.Size = UDim2.new(currentPercent, 0, 1, 0)
                    Thumb.Position = UDim2.new(currentPercent, -9, 0.5, -9)
                    local displayVal = math.floor(min + (max - min) * currentPercent + 0.5)
                    ValueBox.Text = tostring(displayVal)
                    pcall(callback, displayVal)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and dragging then
                    dragging = false
                    Tween(Thumb, {Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(currentPercent, -7, 0.5, -7)}, 0.12)
                end
            end)

            ValueBox.FocusLost:Connect(function(enterPressed)
                local value = tonumber(ValueBox.Text)
                if not value then
                    ValueBox.Text = tostring(math.floor(min + (max - min) * currentPercent + 0.5))
                    return
                end
                value = math.clamp(value, min, max)
                local newPercent = (value - min) / (max - min)
                setPercent(newPercent)
                if enterPressed then
                    ValueBox.Text = tostring(math.floor(min + (max - min) * currentPercent + 0.5))
                end
            end)

            if flagName then
                registerFlag(flagName, function()
                    return math.floor(min + (max - min) * currentPercent + 0.5)
                end, function(value)
                    local newPercent = math.clamp((value - min) / (max - min), 0, 1)
                    setPercent(newPercent)
                end)
            end

            return {
                Set = function(self, value)
                    local newPercent = math.clamp((value - min) / (max - min), 0, 1)
                    setPercent(newPercent)
                end,
                Get = function(self)
                    return math.floor(min + (max - min) * currentPercent + 0.5)
                end,
                OnChanged = function(self, fn)
                    if type(fn) == "function" then
                        onChangedCallback = fn
                    end
                    return self
                end
            }
        end
        
