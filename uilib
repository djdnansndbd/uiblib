                Text = ""
            })

            local flagName = sanitizeFlagName(config.Flag or title)
            local state = default

            if flagName and Library.Options then
                Library.Options[flagName] = Library.Options[flagName] or { Value = default }
            end

            local function ApplyState(animated)
                local dur = animated and 0.18 or 0
                if state then
                    Tween(SwitchBg, {BackgroundColor3 = Theme.Accent}, dur)
                    Tween(SwitchThumb, {Position = UDim2.new(1, -19, 0.5, -8), BackgroundColor3 = Color3.fromRGB(255,255,255)}, dur)
                    Tween(ToggleFrame, {BackgroundColor3 = Color3.fromRGB(36, 36, 42)}, dur)
                else
                    Tween(SwitchBg, {BackgroundColor3 = Theme.Outline}, dur)
                    Tween(SwitchThumb, {Position = UDim2.new(0, 3, 0.5, -8), BackgroundColor3 = Color3.fromRGB(160,160,165)}, dur)
                    Tween(ToggleFrame, {BackgroundColor3 = Theme.ElementBg}, dur)
                end
            end

            local function updateState(value)
                state = value
                if flagName and Library.Options then
                    Library.Options[flagName] = Library.Options[flagName] or {}
                    Library.Options[flagName].Value = state
                end
                ApplyState(true)
                pcall(callback, state)
                if onChangedCallback then
                    pcall(onChangedCallback, state)
                end
                saveDefaultConfig()
            end

            ApplyState(false)
            if default then task.spawn(callback, state) end

            BtnTarget.MouseButton1Click:Connect(function()
                updateState(not state)
            end)

            if flagName then
                registerFlag(flagName, function() return state end, function(value)
                    updateState(value)
                end)
            end

            return {
                Set = function(self, value)
                    updateState(value)
                end,
                Value = function() return state end,
                OnChanged = function(self, fn)
                    if type(fn) == "function" then
                        onChangedCallback = fn
                    end
                    return self
                end
            }
        end
        
