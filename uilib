                TextSize = 12,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd
            })

            local Arrow = Create("TextLabel", {
                Parent = SelBox,
                Size = UDim2.new(0, 20, 1, 0),
                Position = UDim2.new(1, -22, 0, 0),
                BackgroundTransparency = 1,
                Text = "v",
                TextColor3 = Theme.TextMuted,
                TextSize = 10,
                Font = Enum.Font.GothamBold
            })

            local TogBtn = Create("TextButton", {
                Parent = DropFrame,
                Size = UDim2.new(1, 0, 0, 40),
                BackgroundTransparency = 1,
                Text = ""
            })

            local OptionScroll = Create("ScrollingFrame", {
                Parent = DropFrame,
                Size = UDim2.new(1, -20, 1, -44),
                Position = UDim2.new(0, 10, 0, 42),
                BackgroundTransparency = 1,
                ScrollBarThickness = 2,
                ScrollBarImageColor3 = Theme.Outline,
                CanvasSize = UDim2.new(0, 0, 0, #options * 28)
            })
            Create("UIListLayout", { Parent = OptionScroll, SortOrder = Enum.SortOrder.LayoutOrder })

            local function updateLabel()
                if not multi then
                    SelLabel.Text = tostring(selected or "None")
                    return
                end
                local count = 0
                local first = nil
                for opt, _ in pairs(selected) do
                    count += 1
                    if not first then first = opt end
                end
                if count == 0 then SelLabel.Text = "None Selected"
                elseif count == 1 then SelLabel.Text = tostring(first)
                else SelLabel.Text = count .. " Selected" end
            end

            local function buildOptions()
                for _, c in pairs(OptionScroll:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                OptionScroll.CanvasSize = UDim2.new(0, 0, 0, #options * 28)

                for _, opt in ipairs(options) do
                    local isSelected = multi and (selected[opt] == true) or (opt == selected)

                    local ob = Create("TextButton", {
                        Parent = OptionScroll,
                        Size = UDim2.new(1, 0, 0, 28),
                        BackgroundTransparency = isSelected and 0.85 or 1,
                        BackgroundColor3 = Theme.Accent,
                        Text = "  " .. tostring(opt),
                        TextColor3 = isSelected and Theme.Accent or Theme.TextMuted,
                        TextSize = 13,
                        Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left
                    })

                    ob.MouseEnter:Connect(function()
                        if not isSelected then Tween(ob, {TextColor3 = Theme.Text}, 0.1) end
                    end)
                    ob.MouseLeave:Connect(function()
                        if not isSelected then Tween(ob, {TextColor3 = Theme.TextMuted}, 0.1) end
                    end)

                    ob.MouseButton1Click:Connect(function()
                        if multi then
                            selected[opt] = not selected[opt]
                        else
                            selected = opt
                            isOpen = false
                            Tween(DropFrame, {Size = UDim2.new(1, 0, 0, 40)}, 0.2)
                        end

                        updateLabel()
                        buildOptions()

                        local value = multi and selected or selected
                        pcall(callback, value)
                        if onChangedCallback then pcall(onChangedCallback, value) end
                        saveDefaultConfig()
                    end)
                end
            end

            TogBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                local targetHeight = isOpen and math.min(40 + #options * 28, 320) or 40
                Tween(DropFrame, {Size = UDim2.new(1, 0, 0, targetHeight)}, 0.2)
                Arrow.Text = isOpen and "^" or "v"
            end)

            updateLabel()
            buildOptions()

            local flagName = sanitizeFlagName(config.Flag or title)
            if flagName then
                registerFlag(flagName, function() return multi and selected or selected end, function(value)
                    if multi then
                        selected = {}
                        if typeof(value) == "table" then
                            for _, v in ipairs(value) do selected[v] = true end
                        end
                    else
                        selected = value
                    end
                    updateLabel()
                    buildOptions()
                end)
            end

            return {
                Set = function(self, val)
                    if multi then
                        selected = {}
                        if typeof(val) == "table" then
                            for _, v in ipairs(val) do selected[v] = true end
                        end
                    else
                        selected = val
                    end
                    updateLabel()
                    buildOptions()
                    local value = multi and selected or selected
                    pcall(callback, value)
                    if onChangedCallback then pcall(onChangedCallback, value) end
                end,
                Get = function(self) return multi and selected or selected end,
                Refresh = function(self, newOpts) options = newOpts buildOptions() end,
                OnChanged = function(self, fn) if type(fn) == "function" then onChangedCallback = fn end return self end
            }
        end

        return TabObj
    end

    function WindowObj:SelectTab(tabId)
        for _, tab in pairs(self.Tabs) do
            if tab.Id == tabId then
                tab.Page.Visible = true
                Tween(tab.Button, {BackgroundTransparency = 0, BackgroundColor3 = Theme.ElementBg}, 0.2)
                Tween(tab.Label, {TextColor3 = Theme.Text}, 0.2)
                if tab.Accent then Tween(tab.Accent, {BackgroundColor3 = Theme.Accent}, 0.2) end
            else
                tab.Page.Visible = false
                Tween(tab.Button, {BackgroundTransparency = 1}, 0.2)
                Tween(tab.Label, {TextColor3 = Theme.TextMuted}, 0.2)
                if tab.Accent then Tween(tab.Accent, {BackgroundColor3 = Theme.Sidebar}, 0.2) end
            end
        end
        self.CurrentTab = tabId
    end

